/* ------------------------------------------------------------------
   Sea of Thieves - Elite GPC Script for PS5 Pro Controller
   ------------------------------------------------------------------
   مخصص لليد الاحترافية (Elite Controller) للـ PlayStation 5
   مع دعم كامل للأزرار الإضافية والمميزات المتقدمة

   الميزات المحدثة:
   1. Auto Cannon Fire - إطلاق مدافع تلقائي على R2
   2. Equip Cannon - عبي الكنون من Triangle (عادي)
   3. Anti-Recoil - تقليل الارتداد المتقدم
   4. Aim Assist - تصويب احترافي
   5. Mode Toggle - 3 أوضاع متقدمة
   ------------------------------------------------------------------ */

// ========== تعيين أزرار PS5 Pro Controller ==========
define FIRE_BTN       = PS5_R2;      // إطلاق المدفع (تلقائي)
define ADS_BTN        = PS5_L2;      // التصويب
define JUMP_BTN       = PS5_CROSS;   // القفز
define CANNON_BTN     = PS5_TRIANGLE; // عبي الكنون
define RELOAD_BTN     = PS5_SQUARE;  // إعادة تحميل
define MELEE_BTN      = PS5_CIRCLE;  // الهجوم القريب
define LY_AXIS        = PS5_LY;      // محور الحركة الأمام/الخلف
define LX_AXIS        = PS5_LX;      // محور الحركة يسار/يمين
define RX_AXIS        = PS5_RX;      // محور الكاميرا الأفقي
define RY_AXIS        = PS5_RY;      // محور الكاميرا العمودي
define MODE_TOGGLE    = PS5_SHARE;   // تبديل الأوضاع
define L3_BTN         = PS5_L3;      // الركض

// ========== متغيرات التحكم (مضبوطة للأداء العالي) ==========
int auto_cannon_enabled    = TRUE;
int anti_recoil_enabled    = TRUE;
int aim_assist_enabled     = TRUE;

int current_mode           = 2; // 2=Aggressive (الوضع العدواني الافتراضي)
int cannon_speed           = 30; // سرعة إطلاق المدفع (سريع جداً)
int recoil_reduction       = 10; // تقليل الارتداد (دقيق)

// ========== MAIN LOOP ==========
main {
    // تبديل الأوضاع
    if (get_val(MODE_TOGGLE)) {
        combo_run(ToggleMode);
    }

    // إطلاق المدفع التلقائي - سريع جداً
    if (auto_cannon_enabled && get_val(FIRE_BTN)) {
        combo_run(AutoCannonFire);
    }

    // تقليل الارتداد - احترافي
    if (anti_recoil_enabled && get_val(ADS_BTN) && get_val(FIRE_BTN)) {
        combo_run(AntiRecoil);
    }

    // مساعدة التصويب - دقة عالية
    if (aim_assist_enabled && get_val(ADS_BTN)) {
        combo_run(AimAssist);
    }
}

// ========== COMBOS (مخصص للأداء العالي) ==========

// 1. تبديل الأوضاع
combo ToggleMode {
    current_mode++;
    if (current_mode > 3) {
        current_mode = 1;
    }

    if (current_mode == 1) {
        // وضع Normal - متوازن
        cannon_speed = 40;
    } else if (current_mode == 2) {
        // وضع Aggressive - عدواني سريع جداً (الأفضل)
        cannon_speed = 25;
    } else if (current_mode == 3) {
        // وضع Rapid Fire - إطلاق فائق السرعة
        cannon_speed = 15;
    }

    wait(150);
}

// 2. إطلاق المدفع التلقائي - محسّن للأداء العالي
combo AutoCannonFire {
    set_val(FIRE_BTN, 100);
    wait(cannon_speed);
    set_val(FIRE_BTN, 0);
    wait(15);
}

// 3. تقليل الارتداد - دقيق جداً
combo AntiRecoil {
    set_val(RY_AXIS, recoil_reduction);
    wait(60);
    set_val(RY_AXIS, 0);
}

// 4. مساعدة التصويب - تصويب احترافي
combo AimAssist {
    if (get_val(RX_AXIS) > -15 && get_val(RX_AXIS) < 15) {
        set_val(RX_AXIS, get_val(RX_AXIS) * 0.60);
    }
    wait(30);
}

/* ------------------------------------------------------------------
   تحديثات:
   ✅ حذف Fast Bucket (المغرفة السريعة)
   ✅ حذف Fast Sword (السيف السريع)
   ✅ حذف Bunny Hop (القفز)
   ✅ حذف Auto Sprint (الركض التلقائي)
   ✅ إضافة Auto Cannon Fire على R2 (إطلاق تلقائي سريع جداً)
   ✅ Triangle = عبي الكنون (عادي بدون تلقائي)
   ✅ 3 أوضاع للإطلاق (Normal - Aggressive - Rapid Fire)
   ✅ Anti-Recoil و Aim Assist محفوظة
   ------------------------------------------------------------------ */